# Copy to .env and adjust. No secrets are required in Phase 1.

# ---- Backend (read by backend/app/core/config.py, prefix APP_) ----
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# APP_DATA_DIR=/absolute/path/to/data   # defaults to <repo>/data
APP_STUDY_START=2019-01-01
APP_STUDY_END=2025-12-31
APP_TRADING_DAYS_PER_YEAR=252
APP_MONTE_CARLO_SIMULATIONS=50000
APP_RANDOM_SEED=42
# Data pipeline HTTP behaviour (optional; no credentials are needed for any source)
# APP_HTTP_TIMEOUT_SECONDS=60
# APP_HTTP_PAUSE_SECONDS=1.0

# ---- Frontend (see frontend/.env.example, prefix VITE_) ----
# VITE_API_BASE_URL=/api/v1
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
